# 手元で試すとき：このファイルを .dev.vars にコピーして値を入れる（.dev.vars は commit しない）
# 本番：npx wrangler secret put GAS_URL / GAS_BRIDGE_KEY / ADMIN_TOKEN

# GAS のウェブアプリURL（…/exec。キーは付けない）
GAS_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# Apps Script のエディタで setupApi を実行すると出るキー
GAS_BRIDGE_KEY=
# キーとWebhookを管理するための長いランダムな文字列（32文字以上必須・乱数。例：openssl rand -base64 32）
ADMIN_TOKEN=

# 任意
ALLOWED_ORIGINS=https://co-30.github.io
RATE_LIMIT_PER_MIN=60
AUTH_FAIL_LIMIT_PER_MIN=20
